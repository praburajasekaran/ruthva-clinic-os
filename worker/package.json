{
  "name": "ruthva-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "preview": "wrangler dev -c ../frontend/wrangler.jsonc -c wrangler.jsonc --port 8798 --inspector-port 9298 --persist-to .wrangler/state --var FRONTEND_URL:http://localhost:8798 --var CORS_ALLOWED_ORIGINS:http://localhost:8798",
    "verify:pdf": "node scripts/pdf-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node ../scripts/cloudflare-preflight.mjs && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@noble/hashes": "^2.4.0",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261001.0-alpha",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
