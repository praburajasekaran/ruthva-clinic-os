{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruthva-clinic",
  "account_id": "b9280202abca9ff6d2865379031ddb31",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{"pattern": "ruthva.com", "zone_name": "ruthva.com", "custom_domain": true}],
  "vars": {"OPENROUTER_MODEL": "anthropic/claude-sonnet-4.6"},
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "services": [{"binding": "API", "service": "ruthva-api", "environment": "production"}],
  "observability": {"enabled": true}
}
